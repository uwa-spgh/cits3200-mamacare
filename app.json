{
  "expo": {
    "name": "mamaCare",
    "slug": "mamaCare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/flower-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F7",
        "foregroundImage": "./assets/flower-adaptive-foreground.png",
        "monochromeImage": "./assets/flower-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mamacareteamcits3200.mamaCare"
    },
    "web": {
      "favicon": "./assets/flower-favicon.png"
    },
    "plugins": [
      "@react-native-vector-icons/material-icons",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#BC1F58",
          "defaultChannel": "mamacare-important"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b6dd1a28-9deb-4010-9346-e663bb322e16"
      }
    }
  }
}
