{
  "expo": {
    "name": "MamaCare-app1",
    "slug": "MamaCare-app1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-icon-default.png",
    "scheme": "mamacareapp1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icons/ios-icon-default.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "monochromeImage": "./assets/icons/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MamaCareapp1"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icons/ios-icon-default.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {}
  }
}
